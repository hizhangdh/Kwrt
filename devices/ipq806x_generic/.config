
CONFIG_TARGET_ipq806x=y
CONFIG_TARGET_ipq806x_generic=y

CONFIG_TARGET_ipq806x_generic_DEVICE_xiaomi_r3d=y
CONFIG_TARGET_DEVICE_ipq806x_generic_DEVICE_tplink_ad7200=n
CONFIG_TARGET_DEVICE_ipq806x_generic_DEVICE_tplink_c2600=n
CONFIG_TARGET_DEVICE_ipq806x_generic_DEVICE_ubnt_unifi-ac-hd=n

# 增加ext4模块
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-mbcache=y    # 如果编译报错提示缺少
CONFIG_PACKAGE_e2fsprogs=y          # 用户空间工具，格式化/修复 ext4
CONFIG_PACKAGE_libext2fs=y
CONFIG_PACKAGE_libcomerr=y
CONFIG_PACKAGE_libss=y

# 为高通 IPQ 系列芯片启用 NSS（Network Subsystem）硬件加速，关闭IPsec VPN 功能
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_PACKAGE_kmod-ipsec=n

# 关闭普通wifi协议，替换成支持wifi漫游的mesh协议
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-mesh-openssl=y

# 插件配置
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-iperf3-server=y
CONFIG_PACKAGE_luci-app-linkease=y
CONFIG_PACKAGE_luci-app-minidlna=y
CONFIG_PACKAGE_luci-app-samba4=y
